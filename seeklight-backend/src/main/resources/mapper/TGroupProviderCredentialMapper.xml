<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xshxy.seeklightbackend.mapper.TGroupProviderCredentialMapper">

    <resultMap id="BaseResultMap" type="com.xshxy.seeklightbackend.domain.TGroupProviderCredential">
            <id property="id" column="id" />
            <result property="groupId" column="group_id" />
            <result property="providerId" column="provider_id" />
            <result property="apiKey" column="api_key" />
            <result property="isDeleted" column="is_deleted" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <resultMap id="CredentialListItemResultMap" type="com.xshxy.seeklightbackend.domain.dto.GroupProviderCredentialListItemDto">
        <id property="id" column="id" />
        <result property="groupId" column="group_id" />
        <result property="groupName" column="group_name" />
        <result property="providerId" column="provider_id" />
        <result property="providerName" column="provider_name" />
        <result property="apiKey" column="api_key" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,group_id,provider_id,api_key,is_deleted,created_at,
        updated_at
    </sql>

    <select id="selectCredentialPage" resultMap="CredentialListItemResultMap">
        SELECT
            c.id,
            c.group_id,
            g.group_name,
            c.provider_id,
            p.provider_name,
            c.api_key,
            c.created_at,
            c.updated_at
        FROM t_group_provider_credential c
        LEFT JOIN t_group g ON c.group_id = g.group_id AND g.is_deleted = 0
        LEFT JOIN t_model_provider p ON c.provider_id = p.id AND p.is_deleted = 0
        WHERE c.is_deleted = 0
        <if test="groupId != null">
            AND c.group_id = #{groupId}
        </if>
        <if test="providerId != null">
            AND c.provider_id = #{providerId}
        </if>
        ORDER BY c.created_at DESC
    </select>
</mapper>

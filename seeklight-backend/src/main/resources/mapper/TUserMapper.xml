<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xshxy.seeklightbackend.mapper.TUserMapper">

    <resultMap id="BaseResultMap" type="com.xshxy.seeklightbackend.domain.TUser">
        <id property="userId" column="user_id" />
        <result property="userAccount" column="user_account" />
        <result property="password" column="password" />
        <result property="name" column="name" />
        <result property="groupId" column="group_id" />
        <result property="userApiKey" column="user_api_key" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <result property="enabled" column="enabled" />
        <result property="role" column="role" />
    </resultMap>

    <resultMap id="UserListItemResultMap" type="com.xshxy.seeklightbackend.domain.dto.UserListItemDto">
        <id property="userId" column="user_id" />
        <result property="userAccount" column="user_account" />
        <result property="name" column="name" />
        <result property="groupName" column="group_name" />
        <result property="role" column="role" />
        <result property="enabled" column="enabled" />
    </resultMap>

    <resultMap id="UserDetailResultMap" type="com.xshxy.seeklightbackend.domain.dto.UserDetailDto">
        <id property="userId" column="user_id" />
        <result property="userAccount" column="user_account" />
        <result property="name" column="name" />
        <result property="groupId" column="group_id" />
        <result property="groupName" column="group_name" />
        <result property="role" column="role" />
        <result property="enabled" column="enabled" />
    </resultMap>

    <sql id="Base_Column_List">
        user_id,user_account,password,name,group_id,user_api_key,
        is_deleted,created_at,updated_at,enabled,role
    </sql>

    <select id="selectUserPage" resultMap="UserListItemResultMap">
        SELECT
            u.user_id,
            u.user_account,
            u.name,
            g.group_name,
            u.role,
            u.enabled
        FROM t_user u
        LEFT JOIN t_group g ON u.group_id = g.group_id AND g.is_deleted = 0
        WHERE u.is_deleted = 0
        ORDER BY u.created_at DESC
    </select>

    <select id="selectUserDetailById" resultMap="UserDetailResultMap">
        SELECT
            u.user_id,
            u.user_account,
            u.name,
            u.group_id,
            g.group_name,
            u.role,
            u.enabled
        FROM t_user u
        LEFT JOIN t_group g ON u.group_id = g.group_id AND g.is_deleted = 0
        WHERE u.user_id = #{userId}
          AND u.is_deleted = 0
    </select>
</mapper>
